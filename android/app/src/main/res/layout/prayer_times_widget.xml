<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/prayer_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/prayer_widget_background"
    android:padding="10dp"
    android:layoutDirection="rtl">

    <LinearLayout
        android:id="@+id/prayer_widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/prayer_widget_hijri_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start"
            android:text="١٨ ذو القعدة ١٤٤٧ هـ"
            android:textColor="@color/prayer_widget_accent"
            android:textSize="11sp"
            android:fontFamily="@font/cairo_regular"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/prayer_widget_gregorian_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="الثلاثاء، ٢٦ مايو ٢٠٢٦ م"
            android:textColor="@color/prayer_widget_text_secondary"
            android:textSize="11sp"
            android:fontFamily="@font/cairo_regular"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/prayer_widget_times_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/prayer_widget_header"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/prayer_item_fajr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@drawable/prayer_time_item_default">

                <TextView
                    android:id="@+id/prayer_label_fajr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الفجر"
                    android:textColor="@color/prayer_widget_text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="@font/cairo_medium"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/prayer_time_fajr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="04:21"
                    android:textColor="@color/prayer_widget_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/cairo_bold"
                    android:maxLines="1" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/prayer_item_sunrise"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:orientation="vertical"
                android:gravity="center"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                android:background="@drawable/prayer_time_item_default">

                <TextView
                    android:id="@+id/prayer_label_sunrise"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الشروق"
                    android:textColor="@color/prayer_widget_text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="@font/cairo_medium"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/prayer_time_sunrise"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="05:55"
                    android:textColor="@color/prayer_widget_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/cairo_bold"
                    android:maxLines="1" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/prayer_item_dhuhr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@drawable/prayer_time_item_default">

                <TextView
                    android:id="@+id/prayer_label_dhuhr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الظهر"
                    android:textColor="@color/prayer_widget_text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="@font/cairo_medium"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/prayer_time_dhuhr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="12:53"
                    android:textColor="@color/prayer_widget_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/cairo_bold"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/prayer_item_asr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:background="@drawable/prayer_time_item_default">

                <TextView
                    android:id="@+id/prayer_label_asr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="العصر"
                    android:textColor="@color/prayer_widget_text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="@font/cairo_medium"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/prayer_time_asr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="16:30"
                    android:textColor="@color/prayer_widget_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/cairo_bold"
                    android:maxLines="1" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/prayer_item_maghrib"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@drawable/prayer_time_item_default">

                <TextView
                    android:id="@+id/prayer_label_maghrib"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="المغرب"
                    android:textColor="@color/prayer_widget_text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="@font/cairo_medium"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/prayer_time_maghrib"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="19:49"
                    android:textColor="@color/prayer_widget_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/cairo_bold"
                    android:maxLines="1" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/prayer_item_isha"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@drawable/prayer_time_item_default">

                <TextView
                    android:id="@+id/prayer_label_isha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="العشاء"
                    android:textColor="@color/prayer_widget_text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="@font/cairo_medium"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/prayer_time_isha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="21:05"
                    android:textColor="@color/prayer_widget_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/cairo_bold"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
