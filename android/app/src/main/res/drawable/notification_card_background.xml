<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded brand-purple gradient card used as the background of the custom
     prayer notification content view. Mirrors the app/home-widget palette. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="#5E35B1"
        android:centerColor="#6A3FD0"
        android:endColor="#7440E9" />
    <corners android:radius="18dp" />
</shape>
